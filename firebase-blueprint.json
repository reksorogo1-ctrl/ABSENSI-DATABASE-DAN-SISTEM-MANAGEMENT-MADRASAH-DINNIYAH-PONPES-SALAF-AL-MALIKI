{
  "entities": {
    "AppSettings": {
      "title": "AppSettings",
      "description": "Application general settings including branding, social media links, and geofencing coordinates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique settings document identifier"
        },
        "nama_pondok": {
          "type": "string",
          "maxLength": 200,
          "description": "Nama pondok pesantren"
        },
        "nama_madrasah": {
          "type": "string",
          "maxLength": 200,
          "description": "Nama madrasah diniyah"
        },
        "judul_aplikasi": {
          "type": "string",
          "maxLength": 200,
          "description": "Judul aplikasi web"
        },
        "logo_pondok": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL logo pondok"
        },
        "logo_madrasah": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL logo madrasah"
        },
        "background_url": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL background kustom aplikasi"
        },
        "link_instagram": {
          "type": "string",
          "maxLength": 500,
          "description": "Link URL Instagram resmi pondok / madrasah"
        },
        "link_tiktok": {
          "type": "string",
          "maxLength": 500,
          "description": "Link URL TikTok resmi pondok / madrasah"
        },
        "link_youtube": {
          "type": "string",
          "maxLength": 500,
          "description": "Link URL YouTube resmi pondok / madrasah"
        },
        "link_wa": {
          "type": "string",
          "maxLength": 500,
          "description": "Link URL WhatsApp atau nomor WhatsApp admin"
        },
        "geofencing_enabled": {
          "type": "boolean",
          "description": "Status aktifasi geofencing lokasi presensi"
        },
        "geofencing_locked": {
          "type": "boolean",
          "description": "Status kunci lokasi koordinat geofencing"
        },
        "geofencing_zone_name": {
          "type": "string",
          "maxLength": 200,
          "description": "Nama zona radius lokasi"
        },
        "geofencing_latitude": {
          "type": "number",
          "description": "Garis lintang pusat zona geofence"
        },
        "geofencing_longitude": {
          "type": "number",
          "description": "Garis bujur pusat zona geofence"
        },
        "geofencing_radius_meters": {
          "type": "number",
          "description": "Radius absensi dalam meter"
        },
        "geofencing_max_gps_accuracy": {
          "type": "number",
          "description": "Batas akurasi GPS maksimal dalam meter"
        },
        "toleransi_keterlambatan_menit": {
          "type": "number",
          "description": "Toleransi keterlambatan dalam menit"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Waktu pembaruan pengaturan"
        }
      },
      "required": ["id"]
    },
    "AbsensiGuru": {
      "title": "AbsensiGuru",
      "description": "Rekam presensi ustadz / ustadzah pengajar madrasah",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique absensi ID"
        },
        "tanggal": {
          "type": "string",
          "maxLength": 32,
          "description": "Tanggal presensi YYYY-MM-DD"
        },
        "nama": {
          "type": "string",
          "maxLength": 150,
          "description": "Nama ustadz / pengajar"
        },
        "mapel": {
          "type": "string",
          "maxLength": 150,
          "description": "Mata pelajaran"
        },
        "kelas": {
          "type": "string",
          "maxLength": 100,
          "description": "Kelas bimbingan / angkatan"
        },
        "status": {
          "type": "string",
          "maxLength": 50,
          "enum": ["Hadir", "Terlambat", "Izin", "Alpha"],
          "description": "Status kehadiran"
        },
        "catatan": {
          "type": "string",
          "maxLength": 500,
          "description": "Catatan absensi"
        },
        "hari": {
          "type": "string",
          "maxLength": 50,
          "description": "Hari mengajar"
        },
        "jamKe": {
          "type": "string",
          "maxLength": 20,
          "description": "Jam mengajar ke-n"
        },
        "waktu": {
          "type": "string",
          "maxLength": 30,
          "description": "Waktu presensi jam:menit"
        },
        "latitude": {
          "type": "number",
          "description": "Koordinat latitude presensi"
        },
        "longitude": {
          "type": "number",
          "description": "Koordinat longitude presensi"
        },
        "jarak": {
          "type": "number",
          "description": "Jarak ke pusat zona dalam meter"
        },
        "zona": {
          "type": "string",
          "maxLength": 200,
          "description": "Nama zona saat presensi"
        },
        "tipeAbsensi": {
          "type": "string",
          "maxLength": 50,
          "enum": ["Normal", "Pengganti"],
          "description": "Tipe absensi normal atau pengganti"
        }
      },
      "required": ["id", "tanggal", "nama", "status"]
    },
    "AbsensiSantri": {
      "title": "AbsensiSantri",
      "description": "Rekam presensi santri per kelas dan tanggal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique absensi santri ID"
        },
        "tanggal": {
          "type": "string",
          "maxLength": 32,
          "description": "Tanggal presensi"
        },
        "idSantri": {
          "type": "string",
          "maxLength": 64,
          "description": "Nomor Induk Santri (NIS)"
        },
        "nama": {
          "type": "string",
          "maxLength": 150,
          "description": "Nama lengkap santri"
        },
        "kelas": {
          "type": "string",
          "maxLength": 100,
          "description": "Kelas santri"
        },
        "status": {
          "type": "string",
          "maxLength": 50,
          "enum": ["Hadir", "Izin", "Sakit", "Alpha"],
          "description": "Status kehadiran"
        },
        "keterangan": {
          "type": "string",
          "maxLength": 500,
          "description": "Keterangan absensi"
        }
      },
      "required": ["id", "tanggal", "idSantri", "nama", "status"]
    },
    "Santri": {
      "title": "Santri",
      "description": "Data induk santri pondok pesantren dan madrasah diniyah",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Nomor Induk Santri (NIS)"
        },
        "nama": {
          "type": "string",
          "maxLength": 150,
          "description": "Nama lengkap santri"
        },
        "kelas": {
          "type": "string",
          "maxLength": 100,
          "description": "Kelas santri"
        },
        "kamar": {
          "type": "string",
          "maxLength": 100,
          "description": "Kamar asrama santri"
        },
        "alamat": {
          "type": "string",
          "maxLength": 300,
          "description": "Alamat asal santri"
        },
        "foto": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL foto santri"
        },
        "namaOrangTua": {
          "type": "string",
          "maxLength": 150,
          "description": "Nama orang tua / wali"
        },
        "saldoUangSaku": {
          "type": "number",
          "description": "Saldo tabungan uang saku santri"
        }
      },
      "required": ["id", "nama", "kelas"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Daftar hak akses admin terdaftar di Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID admin"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Email admin"
        },
        "role": {
          "type": "string",
          "maxLength": 50,
          "description": "Role admin"
        }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Pengaturan menyeluruh aplikasi termasuk sosial media dan koordinat geofencing"
    },
    "/absensi_guru/{absensiId}": {
      "schema": "AbsensiGuru",
      "description": "Rekam presensi pengajar madrasah dengan validasi geofencing lokasi"
    },
    "/absensi_santri/{absensiId}": {
      "schema": "AbsensiSantri",
      "description": "Rekam presensi santri harian madrasah diniyah"
    },
    "/santri/{santriId}": {
      "schema": "Santri",
      "description": "Data master santri dan portal wali santri"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Dokumen verifikasi role administrator sistem"
    }
  }
}
